# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Code and configuration files must always use LF
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.csv text eol=lf
*.xml text eol=lf

# Dotfiles
.gitignore text eol=lf
.gitattributes text eol=lf
.dvcignore text eol=lf
.pre-commit-config.yaml text eol=lf
.commitlintrc.yaml text eol=lf

# Pipeline & Project configs
dvc.yaml text eol=lf
params.yaml text eol=lf
Makefile text eol=lf
Dockerfile* text eol=lf
