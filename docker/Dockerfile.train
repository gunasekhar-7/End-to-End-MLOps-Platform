# Dockerfile for training
# Multi-stage build: builder -> runtime

# Builder stage
FROM python:3.11-slim as builder

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy dependency files
COPY pyproject.toml uv.lock* ./

# Copy source code first (needed for package build)
COPY src/ ./src/
COPY params.yaml dvc.yaml ./
COPY README.md ./

# Install dependencies (including the package)
RUN uv sync --frozen --no-dev

# Runtime stage
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy installed packages from builder
COPY --from=builder /app/.venv /app/.venv

# Copy source code
COPY --from=builder /app/src ./src
COPY --from=builder /app/params.yaml /app/dvc.yaml ./

# Copy DVC config
COPY .dvc/ ./.dvc/

# Create directories for data and models
RUN mkdir -p data/raw data/processed models metrics reports

# Set PATH to use venv
ENV PATH="/app/.venv/bin:$PATH"

# Default command
CMD ["python", "-m", "mlops_fraud_detection.train.train"]