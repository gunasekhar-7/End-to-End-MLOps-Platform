# Environment variables template
# Copy to .env and fill in your values
# DO NOT COMMIT .env FILE - it's in .gitignore

# ==========================================
# MLflow Configuration
# ==========================================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_ARTIFACT_ROOT=s3://mlops-fraud-data/mlflow

# ==========================================
# MinIO / S3 Configuration (DVC Remote)
# ==========================================
# Development (MinIO local)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mlops-fraud-data
MINIO_REGION=us-east-1

# Production (AWS S3) - uncomment and configure for production
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_DEFAULT_REGION=us-east-1
# AWS_S3_BUCKET=your-production-bucket
# DVC_REMOTE_URL=s3://your-production-bucket

# ==========================================
# Model Serving Configuration
# ==========================================
MODEL_PATH=models/model.pkl
PREPROCESSOR_PATH=models/preprocessor.pkl
MODEL_THRESHOLD=0.5
SERVE_HOST=0.0.0.0
SERVE_PORT=8000
LOG_LEVEL=INFO

# ==========================================
# MLflow Model Registry (Alternative to local model loading)
# ==========================================
MLFLOW_MODEL_URI=models:/fraud-detection/Production
MLFLOW_MODEL_STAGE=Production

# ==========================================
# Monitoring Configuration
# ==========================================
DRIFT_CHECK_INTERVAL_HOURS=24
PSI_THRESHOLD=0.2
KS_THRESHOLD=0.05
PREDICTION_DRIFT_THRESHOLD=2.0
MODEL_STALENESS_DAYS=30

# ==========================================
# Prometheus / Grafana
# ==========================================
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ==========================================
# Alerting (Optional)
# ==========================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_EMAIL_RECIPIENTS=team@example.com

# ==========================================
# Database (Optional - for prediction logging)
# ==========================================
# DATABASE_URL=postgresql://user:pass@localhost:5432/fraud_detection

# ==========================================
# GitHub Actions / CI (Set in GitHub Environments, not .env)
# ==========================================
# GH_TOKEN=ghp_xxx
# DOCKER_HUB_USERNAME=your-username
# DOCKER_HUB_TOKEN=dckr_pat_xxx